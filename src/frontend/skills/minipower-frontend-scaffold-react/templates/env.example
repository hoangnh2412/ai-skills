# Đích: .env.example (commit) — bản chạy thật: .env.development / .env.local (KHÔNG commit)
# MỌI biến VITE_* bị nhúng vào bundle trình duyệt — không đặt secret thật ở đây.

# Base URL của axios dùng chung — dev: same-origin + proxy Vite
VITE_API_URL=/api/

# Backend dev mà proxy /api trỏ tới
VITE_API_PROXY_TARGET=https://localhost:7006

# Chỉ khi backend dùng scheme API key (header + giá trị lộ trong bundle — chỉ hợp môi trường nội bộ)
# VITE_API_KEY=
# VITE_API_KEY_NAME=X-API-KEY
